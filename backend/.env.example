NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# docker compose up -d (from repo root) starts both of these
MONGODB_URI=mongodb://localhost:27017/redrelay?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# JWT authentication
JWT_ACCESS_SECRET=super-secret-jwt-access-key-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-32-chars-long!
JWT_REFRESH_EXPIRES_IN=7d

